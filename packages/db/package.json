{
  "name": "@lms/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@lms/course-schema": "workspace:*",
    "@lms/course-engine": "workspace:*",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "zod": "4.6.7",
    "pdf-parse": "2.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
