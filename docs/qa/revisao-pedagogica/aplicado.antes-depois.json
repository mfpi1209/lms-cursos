   "trilha": "convivencia",
   "situacao": "cv2",
   "opcao": "a",
   "campo": "label",
   "antes": "“Digo que ela está errada.”",
   "depois": "“Digo que ela está errada e que o prazo sempre foi sexta.”",
   "estado": "aplicar"
  },
  {
   "item": "P22",
