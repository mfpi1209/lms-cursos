   "antes": "“Aviso que só tenho a cinza-escura e pergunto se serve ou qual alternativa usar.”",
   "depois": "“Aviso que só tenho a cinza-escura e pergunto se serve.”",
   "estado": "aplicar"
  },
  {
   "item": "P13",
   "trilha": "imagem-e-postura",
   "situacao": "ip2",
   "opcao": "b",
   "campo": "label",
   "antes": "“Vou com a cinza e não falo nada.”",
   "depois": "“Vou com a cinza-escura e não comento nada com ninguém.”",
   "estado": "aplicar"
  },
  {
   "item": "P13",
   "trilha": "imagem-e-postura",
   "situacao": "ip2",
   "opcao": "c",
   "campo": "label",
   "antes": "“Falto no sábado.”",
   "depois": "“Falto no sábado para não aparecer com a roupa errada.”",
   "estado": "aplicar"
  },
  {
   "item": "P14",
   "trilha": "imagem-e-postura",
   "situacao": "ip3",
   "opcao": "b",
   "campo": "label",
   "antes": "“Pergunto em qual situação isso aconteceu e o que esperam que eu faça diferente.”",
   "depois": "“Pergunto em qual situação foi e o que esperam que eu faça.”",
   "estado": "aplicar"
  },
  {
   "item": "P14",
   "trilha": "imagem-e-postura",
   "situacao": "ip3",
   "opcao": "a",
   "campo": "label",
   "antes": "“Digo que vou melhorar e mudo tudo um pouco.”",
   "depois": "“Digo que vou melhorar e tento mudar um pouco de tudo.”",
   "estado": "aplicar"
  },
  {
   "item": "P14",
   "trilha": "imagem-e-postura",
   "situacao": "ip3",
   "opcao": "c",
   "campo": "label",
   "antes": "“Digo que sempre fui assim.”",
   "depois": "“Digo que sempre fui assim e que isso não vai mudar.”",
   "estado": "aplicar"
  },
  {
   "item": "P15",
   "trilha": "imagem-e-postura",
   "situacao": "ip4",
   "opcao": "c",
   "campo": "label",
   "antes": "“Digo com calma que posso conversar sobre a tarefa, mas não sobre esse comentário, e procuro a pessoa de referência.”",
   "depois": "“Digo que falo sobre a tarefa, não sobre esse comentário, e procuro apoio.”",
   "estado": "aplicar"
  },
  {
   "item": "P15",
   "trilha": "imagem-e-postura",
   "situacao": "ip4",
   "opcao": "a",
   "campo": "label",
   "antes": "“Respondo no mesmo tom.”",
   "depois": "“Respondo no mesmo tom, na frente de todo mundo.”",
   "estado": "aplicar"
  },
  {
   "item": "P15",
   "trilha": "imagem-e-postura",
   "situacao": "ip4",
   "opcao": "b",
   "campo": "label",
   "antes": "“Finjo que não ouvi e deixo pra lá.”",
   "depois": "“Finjo que não ouvi e deixo pra lá, para não criar clima.”",
   "estado": "aplicar"
  },
  {
   "item": "P16",
   "trilha": "imagem-e-postura",
   "situacao": "ip5",
   "opcao": "b",
   "campo": "label",
   "antes": "“Não posto essa foto e pergunto se posso tirar outra, com autorização de quem aparece.”",
   "depois": "“Não posto essa e tiro outra, com autorização de quem aparece.”",
   "estado": "aplicar"
  },
  {
   "item": "P16",
   "trilha": "imagem-e-postura",
   "situacao": "ip5",
   "opcao": "c",
   "campo": "label",
   "antes": "“Posto só para os amigos próximos.”",
   "depois": "“Posto só para os amigos próximos, que não vão espalhar.”",
   "estado": "aplicar"
  },
  {
   "item": "P17",
   "trilha": "imagem-e-postura",
   "situacao": "ip6",
   "opcao": "a",
   "campo": "label",
   "antes": "“Apago o vídeo, aviso o colega e sigo a orientação da empresa se precisar.”",
   "depois": "“Apago o vídeo, aviso o colega e sigo a orientação da empresa.”",
   "estado": "aplicar"
  },
  {
   "item": "P17",
   "trilha": "imagem-e-postura",
   "situacao": "ip6",
   "opcao": "b",
   "campo": "label",
   "antes": "“Deixo, porque já tem muitas visualizações.”",
   "depois": "“Deixo no ar, porque já tem muitas visualizações e ficou bom.”",
   "estado": "aplicar"
  },
  {
   "item": "P18",
   "trilha": "rotina-e-combinados",
   "situacao": "rc1",
   "opcao": "a",
   "campo": "label",
   "antes": "“Aviso que terminei, onde está o arquivo e o que ficou pendente.”",
   "depois": "“Aviso que terminei, onde está e o que ficou pendente.”",
   "estado": "aplicar"
  },
  {
   "item": "P18",
   "trilha": "rotina-e-combinados",
   "situacao": "rc1",
   "opcao": "b",
   "campo": "label",
   "antes": "“Não aviso: quem precisar vai achar na pasta.”",
   "depois": "“Não aviso: quem precisar vai achar o arquivo na pasta.”",
   "estado": "aplicar"
  },
  {
   "item": "P18",
   "trilha": "rotina-e-combinados",
   "situacao": "rc1",
   "opcao": "c",
   "campo": "label",
   "antes": "“Digo só ‘feito!’.”",
   "depois": "“Mando só ‘feito!’ no grupo e volto para outra tarefa.”",
   "estado": "aplicar"
  },
  {
   "item": "P19",
   "trilha": "rotina-e-combinados",
   "situacao": "rc2",
   "opcao": "b",
   "campo": "label",
   "antes": "“Pergunto um exemplo do que pode e do que não pode na minha função.”",
   "depois": "“Peço um exemplo do que pode e do que não pode no balcão.”",
   "estado": "aplicar"
  },
  {
   "item": "P19",
   "trilha": "rotina-e-combinados",
   "situacao": "rc2",
   "opcao": "a",
   "campo": "label",
   "antes": "“Faço como os colegas fazem.”",
   "depois": "“Faço como os colegas fazem, porque eles já conhecem a regra.”",
   "estado": "aplicar"
  },
  {
   "item": "P19",
   "trilha": "rotina-e-combinados",
   "situacao": "rc2",
   "opcao": "c",
   "campo": "label",
   "antes": "“Não uso o celular nunca, para não errar.”",
   "depois": "“Não uso o celular nunca no trabalho, para não errar.”",
   "estado": "aplicar"
  },
  {
   "item": "P20",
   "trilha": "rotina-e-combinados",
   "situacao": "rc3",
   "opcao": "c",
   "campo": "label",
