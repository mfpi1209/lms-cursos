   "depois": "“Interrompo na hora e falo tudo de uma vez, sem avisar.”",
   "estado": "aplicar"
  },
  {
   "item": "P22",
   "trilha": "convivencia",
   "situacao": "cv2",
   "opcao": "c",
   "campo": "label",
   "antes": "“Digo que entendi sexta e pergunto como podemos alinhar o prazo.”",
   "depois": "“Digo que entendi sexta e pergunto como alinhar o prazo.”",
   "estado": "aplicar"
  },
  {
