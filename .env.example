# Banco de dados (PostgreSQL 15+)
DATABASE_URL=postgres://localhost:5432/lms_cursos
# Banco usado pelos testes de integração (é truncado/migrado pelos testes)
TEST_DATABASE_URL=postgres://localhost:5432/lms_cursos_test

# Redis (fila BullMQ do worker). O fluxo principal web funciona sem Redis.
REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_SECRET=troque-por-um-segredo-com-32-ou-mais-caracteres
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Identidade visual configurável
NEXT_PUBLIC_BRAND_NAME="Rede de Polos"
NEXT_PUBLIC_BRAND_PRIMARY=#0e7c86

# TRAVA DE GASTO (auditoria P0-1). Sem ALLOW_PAID_PROVIDERS=1 NENHUMA chamada paga sai deste processo, mesmo com
# AI_PROVIDER e chaves definidos: a IA cai para `fake` (modo de demonstração) e a mídia para simulação.
# Vale também em produção (NODE_ENV=production não libera sozinho): o ambiente de produção DEVE definir
# ALLOW_PAID_PROVIDERS=1 explicitamente, nos DOIS processos (web e worker). O worker recusa execuções
# criadas pela web com provedor diferente do que ele resolve ("provedor divergente entre web e worker").
ALLOW_PAID_PROVIDERS=

# Agente de construção (IA). AI_PROVIDER: anthropic | openai | fake (fake = MODO DE DEMONSTRAÇÃO com propostas-modelo genéricas)
# Sem AI_PROVIDER: usa anthropic se ANTHROPIC_API_KEY existir, senão openai se OPENAI_API_KEY + OPENAI_MODEL, senão desabilitado.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
# fallback entre fornecedores só em erro transitório (429/5xx/rede); reenvia o pedido ao segundo fornecedor
AI_FALLBACK_PROVIDER=
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=

# Custo e teto de gasto (valores em USD; ESTIMATIVAS pelas tabelas abaixo — a fatura do provedor é a referência)
# Tabela de preços da IA por id de modelo (ou prefixo), USD por 1M tokens; sobrescreve os padrões de packages/ai/src/pricing.ts
# ex.: {"gpt-5":{"input":1.25,"output":10,"cacheRead":0.125},"claude-opus-5-5":{"input":4,"output":20,"cacheRead":0.2}}
AI_PRICES_JSON=
# Tabela de preços de mídia; sobrescreve os padrões de packages/media/src/pricing.ts
# ex.: {"elevenLabsUsdPer1kChars":0.3,"heygenUsdPerSecond":0.0167,"heygenCinematicUsdPerSecond":0.12}
MEDIA_PRICES_JSON=
# Teto por workspace nas últimas 24 h (janela deslizante). Vazio = padrão (mídia 50, IA 20); -1 ou unlimited = sem teto; 0 = bloqueia.
# Conta o custo real dos itens concluídos e o ESTIMADO dos abertos (fila/execução). Pedido que ultrapassaria devolve 402.
# Override por workspace: coluna workspaces.spend_limits ({"mediaDailyUsd":..,"aiDailyUsd":..}).
MEDIA_DAILY_BUDGET_USD=
AI_DAILY_BUDGET_USD=
# Execução de IA aberta ainda sem custo conhecido: valor estimado contado no teto (padrão 0.50)
AI_RUN_ESTIMATE_USD=
# Validade do orçamento de produção (POST /media-jobs/quote), em minutos (padrão 30)
MEDIA_QUOTE_TTL_MIN=

# Storage de mídia (vídeos/áudios gerados, imagens de fundo, PDFs de fonte).
# STORAGE_PROVIDER: local | s3. Vazio = s3 se S3_BUCKET estiver definido, senão local.
# Em qualquer provider os arquivos são servidos pela aplicação em /api/assets/[id] (com Range);
# o bucket nunca precisa ser público nem ter CORS.
STORAGE_PROVIDER=local
# local: diretório em disco (use volume persistente em container)
STORAGE_DIR=.data/storage
# s3: AWS S3 ou compatível (MinIO, Cloudflare R2, Backblaze B2). Obrigatórios com s3: S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY.
S3_BUCKET=
# região (padrão us-east-1; R2 usa "auto")
S3_REGION=
# endpoint só para provedores não-AWS, URL completa (ex.: https://minio.interno:9000, https://<account>.r2.cloudflarestorage.com)
S3_ENDPOINT=
# 1/true para path-style (bucket no caminho, não no host): obrigatório no MinIO, recomendado em self-hosted
S3_FORCE_PATH_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# prefixo opcional dentro do bucket (ex.: lms/prod), sem barra inicial
S3_PREFIX=

# Geração de mídia por cena (fase C). Sem HEYGEN_API_KEY ou sem ALLOW_PAID_PROVIDERS=1 o modo é SIMULADO (jobs identificados como simulação, sem vídeo).
MEDIA_SIMULATION=
HEYGEN_WEBHOOK_SECRET=
HEYGEN_CALLBACK_URL=
ELEVENLABS_MODEL_ID=eleven_v4
# menor = voz mais expressiva (0 a 1)
ELEVENLABS_STABILITY=0.35
# intervalo de reconciliação de jobs em execução (worker)
MEDIA_POLL_MS=15000

# limite de vídeos pagos em produção ao mesmo tempo por curso
MEDIA_MAX_OPEN_PER_COURSE=5

# Direção cinematográfica (vídeo por planos montado com ffmpeg no worker)
# clipes de plano enviados ao HeyGen ao mesmo tempo por vídeo dirigido
MEDIA_MAX_SHOTS_IN_FLIGHT=3
# preset do x264 na montagem (ultrafast..veryslow; mais lento = arquivo menor)
COMPOSE_X264_PRESET=veryfast
# caminhos do ffmpeg/ffprobe (vazio = procurar no PATH)
FFMPEG_PATH=
FFPROBE_PATH=
# fontes dos slides (vazio = Inter embutida)
SLIDE_FONT_PATH=
SLIDE_FONT_BOLD_PATH=
# resolução das cenas em movimento (cinematic_avatar): 720p (padrão, ~60 créditos/plano no app) ou 1080p (~150)
MEDIA_CINEMATIC_RESOLUTION=720p

# tamanho do pool de conexões por processo (web e worker)
DB_POOL_MAX=10

# --- IP do cliente atrás do proxy (EasyPanel/Traefik) e registro de acesso (Marco Civil) ---
# TRUSTED_PROXIES=172.18.0.0/16        # IP/CIDR do proxy à frente do app (use o endereço real, não uma faixa larga)
# CLIENT_IP_HEADERS=x-forwarded-for    # atrás do Cloudflare: cf-connecting-ip,x-forwarded-for
# CLIENT_PORT_HEADER=                  # só se o proxy repassar a porta de origem do cliente

# --- Retenção de dados (worker; ver apps/worker/src/retention.ts). Padrões = propostas a confirmar pelo advogado ---
# RETENTION_ENABLED=1                  # padrão: ligada só com NODE_ENV=production
# RETENTION_DRY_RUN=0                  # 1 = só registra no log o que apagaria
# RETENTION_SESSIONS_DAYS=30
# RETENTION_OUTBOX_DAYS=30
# RETENTION_AUDIT_DAYS=730
# RETENTION_ACCESS_LOG_MONTHS=6        # nunca abaixo de 6
# RETENTION_CLOSED_ACCOUNTS_ENABLED=0  # desligado até o advogado confirmar
# RETENTION_CLOSED_ACCOUNTS_MONTHS=12
# RETENTION_BADGE_EXPIRY_ENABLED=0     # desligado até o advogado confirmar
# RETENTION_BADGE_YEARS=5
